      "destination": "/compare/martal.html"
    },
    {
      "source": "/compare/cience",
      "destination": "/compare/cience.html"
    },
    {
      "source": "/compare/cleverly",
      "destination": "/compare/cleverly.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/blog/:slug.html"
    },
    {
      "source": "/authors/:slug([a-z0-9-]+)",
      "destination": "/authors/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
