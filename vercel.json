  "rewrites": [
    {
      "source": "/case-studies",
      "destination": "/case-studies.html"
    },
    {
      "source": "/case-studies/:slug",
      "destination": "/case-studies/:slug.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    },
    {
      "source": "/cold-email-agency",
      "destination": "/cold-email-agency.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/compare",
      "destination": "/compare.html"
    },
    {
      "source": "/compare/belkins",
